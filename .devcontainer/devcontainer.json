{
    "name": "gke-2-scc-devcontainer",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // "image": "us-central1-docker.pkg.dev/anthos-bare-metal-lab-1/gdc-solutions/gdc-pdk-devcontainer:0.0.1",
    "runArgs": ["--env-file", "${localWorkspaceFolder}/.devcontainer/.env"],
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "ms-azuretools.vscode-docker",
                "hashicorp.terraform",
                "hashicorp.hcl",
                "golang.go",
                "googlecloudtools.cloudcode",
                "esbenp.prettier-vscode",
                "quicktype.quickt",
                "hookyqr.beautify",
                "MarkLarah.pre-commit-vscode"
            ],
            "settings": {
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "terminal.integrated.defaultProfile.linux": "zsh",
                "terminal.integrated.shell.linux": {
                    "zsh": {
                        "path": "zsh"
                      }
                }
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2.5.7": {
            "version": "latest",
            "installZsh": true,
            "installOhMyZsh": true,
            "upgradePackages": true,
            "username": "vscode"
        },
        "ghcr.io/devcontainers/features/terraform:1.4.2": {
            "version": "1.14.8",
            "terragrunt": "1.0.0",
            "installTerraformDocs": true
        },
        "ghcr.io/devcontainers/features/go:1.3.3": {
            "version": "1.26"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {}
    },
    "postStartCommand": {
        "setAliases": "echo '' >> /home/vscode/.zshrc && cat ${containerWorkspaceFolder}/scripts/aliases.sh >> /home/vscode/.zshrc",
        "setupGitHooks": "cp ${containerWorkspaceFolder}/scripts/git-hooks/* ${containerWorkspaceFolder}/.git/hooks/",
        "addGitSafeDirectory": "git config --global --add safe.directory ${containerWorkspaceFolder}"
    },
    "postAttachCommand": "${containerWorkspaceFolder}/scripts/glogin.sh ${containerWorkspaceFolder}"
}